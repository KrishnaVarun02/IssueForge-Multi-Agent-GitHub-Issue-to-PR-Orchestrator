OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2

# Workflow budgets. Zero means unlimited or not configured.
LLM_MAX_TOTAL_TOKENS=0
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_MAX_COST_USD=0

# Optional for public issues; required for private repositories.
GITHUB_TOKEN=
